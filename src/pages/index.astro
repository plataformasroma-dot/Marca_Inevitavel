    <script is:inline>
      const countdown = document.querySelector('[data-countdown]');

      if (countdown) {
        const targetDate = new Date(countdown.dataset.countdownTarget);

        const renderCountdown = () => {
          const remainingMs = Math.max(targetDate.getTime() - Date.now(), 0);
          const totalSeconds = Math.floor(remainingMs / 1000);
          const totalMinutes = Math.floor(totalSeconds / 60);
          const days = Math.floor(totalMinutes / 1440);
          const hours = Math.floor((totalMinutes % 1440) / 60);
          const minutes = totalMinutes % 60;
          const seconds = totalSeconds % 60;

          countdown.textContent = `faltam ${days}d ${hours}h ${minutes}m ${seconds}s`;
        };

        renderCountdown();
        setInterval(renderCountdown, 1000);
      }

      const stickyCta = document.querySelector('.sticky-cta');
      const stickyWatchTargets = document.querySelectorAll('.hero .btn, #planos, .cta-band');

      if (stickyCta && 'IntersectionObserver' in window) {
        const visibleTargets = new Set();
        const syncStickyCta = () => {
          stickyCta.classList.toggle('sticky-cta--hidden', visibleTargets.size > 0);
        };

        const stickyObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                visibleTargets.add(entry.target);
              } else {
                visibleTargets.delete(entry.target);
              }
            });

            syncStickyCta();
          },
          { threshold: 0.12, rootMargin: '0px 0px -12% 0px' }
        );

        stickyWatchTargets.forEach((target) => stickyObserver.observe(target));
      }
    </script>

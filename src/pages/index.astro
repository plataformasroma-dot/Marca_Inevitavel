---
import { pageAssets, withBasePath } from '../lib/asset-paths.js';
import { eventDateLabel, marqueeDateLabel, standardTicketPrice } from '../lib/landing-content.js';

const standardCheckout =
  import.meta.env.PUBLIC_STANDARD_CHECKOUT ??
  'https://lastlink.com/p/CAC25862D/checkout-payment/';
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID ?? '1269431951336148';

const assetPath = (path) => withBasePath(import.meta.env.BASE_URL, path);
const assetStyleVars = [
  `--font-editorial-regular-src: url("${assetPath(pageAssets.fontEditorialRegular)}") format("woff")`,
  `--font-editorial-italic-src: url("${assetPath(pageAssets.fontEditorialItalic)}") format("woff")`,
  `--font-aileron-bold-src: url("${assetPath(pageAssets.fontAileronBold)}") format("woff")`,
  `--hero-image: url("${assetPath(pageAssets.hero)}")`
].join('; ');
const logoImage = assetPath(pageAssets.logo);
const portraitImage = assetPath(pageAssets.portrait);
const standardTicketPriceLabel = `R$${standardTicketPrice}`;
const eventCountdownTarget = '2026-07-25T00:00:00-03:00';
---

<!doctype html>
<html lang="pt-BR" style={assetStyleVars}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Imersão Marca Inevitável — imersão estratégica ao vivo com Yasmin Corbo."
    />
    <title>Marca Inevitável — Imersão com Yasmin Corbo</title>
    <script is:inline define:vars={{ metaPixelId }}>
      !function(f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function() {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = true;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = true;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', metaPixelId);
      fbq('track', 'PageView');
    </script>
    <style>
      @font-face {
        font-family: 'PP Editorial New';
        src: var(--font-editorial-regular-src);
        font-style: normal;
        font-weight: 200;
        font-display: swap;
      }

      @font-face {
        font-family: 'PP Editorial New';
        src: var(--font-editorial-italic-src);
        font-style: italic;
        font-weight: 200;
        font-display: swap;
      }

      @font-face {
        font-family: 'Aileron Extra Bold';
        src: var(--font-aileron-bold-src);
        font-style: normal;
        font-weight: 800;
        font-display: swap;
      }

      @font-face {
        font-family: 'Aileron Extra Bold';
        src: var(--font-aileron-bold-src);
        font-style: normal;
        font-weight: 900;
        font-display: swap;
      }

      :root {
        --bg: #f5f0e8;
        --bg-2: #ede5d8;
        --ink: #0b112e;
        --ink-soft: #2a3050;
        --muted: #6b7088;
        --hairline: rgba(11, 17, 46, 0.16);
        --granada: #f18523;
        --granada-deep: #c96a14;
        --gold: #0b112e;
        --container: min(1180px, 100% - 72px);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: 'Aileron Extra Bold', Arial, sans-serif;
        font-size: 16px;
        line-height: 1.55;
        font-synthesis: none;
      }

      body {
        overflow-x: hidden;
        min-height: 100vh;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .serif {
        font-family: 'PP Editorial New', Georgia, serif;
        font-weight: 200;
      }

      .mono {
        font-family: 'Aileron Extra Bold', Arial, sans-serif;
        letter-spacing: 0.11em;
        text-transform: uppercase;
        font-size: 11px;
      }

      .grain::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.28;
        mix-blend-mode: multiply;
        z-index: 50;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.12  0 0 0 0 0.08  0 0 0 0 0.06  0 0 0 0.1 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
      }

      .page {
        position: relative;
        z-index: 1;
      }

      .hero {
        position: relative;
        min-height: 100dvh;
        padding: 82px 0 40px;
        background:
          linear-gradient(130deg, rgba(11, 17, 46, 0.72), rgba(11, 17, 46, 0.15) 60%, rgba(11, 17, 46, 0.56)),
          var(--hero-image) center/cover no-repeat;
      }

      .hero::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(11, 17, 46, 0.17), rgba(11, 17, 46, 0.72));
        z-index: -1;
      }

      .shell {
        width: var(--container);
        margin: 0 auto;
      }

      .hero-marquee {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 80;
        overflow: hidden;
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(4, 8, 34, 0.72);
        backdrop-filter: blur(8px);
        pointer-events: none;
      }

      .marquee-track {
        display: inline-flex;
        width: max-content;
        min-width: 200%;
        flex-wrap: nowrap;
        will-change: transform;
        animation: marquee 26s linear infinite;
      }

      .marquee-copy {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        gap: 24px;
        padding: 16px 12px;
        white-space: nowrap;
        color: var(--granada);
        font-family: 'Aileron Extra Bold', Arial, sans-serif;
        font-size: 11px;
        letter-spacing: 0.18em;
        line-height: 1;
        text-transform: uppercase;
      }

      .marquee-copy span {
        opacity: 0.96;
        display: inline-block;
        flex: 0 0 auto;
      }

      .marquee-copy .dot {
        opacity: 0.45;
      }

      @keyframes marquee {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-50%);
        }
      }

      .hero-main {
        position: relative;
        margin-top: 0;
        min-height: calc(100dvh - 122px);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 18px;
        text-align: center;
      }

      .hero-title {
        margin: 0 0 12px;
        font-size: clamp(58px, 10.8vw, 180px);
        line-height: 0.92;
        letter-spacing: -0.04em;
        font-weight: 200;
        color: var(--bg);
      }

      .hero-title span {
        color: var(--granada);
        font-style: italic;
      }

      .hero-logo-title {
        margin: 0 0 14px;
        width: min(920px, 92vw);
      }

      .hero-logo {
        display: block;
        width: 100%;
        height: auto;
      }

      .countdown {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        margin: 0 0 18px;
        padding: 10px 18px;
        border: 1px solid rgba(245, 240, 232, 0.2);
        border-radius: 999px;
        background: rgba(4, 8, 34, 0.54);
        color: var(--granada);
        font-size: 12px;
        letter-spacing: 0.14em;
        line-height: 1;
        text-transform: uppercase;
        backdrop-filter: blur(8px);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .hero-grid {
        width: 100%;
        display: flex;
        justify-content: center;
      }

      .hero-copy {
        max-width: 760px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .hero-subcopy {
        color: #fff;
        font-size: clamp(15px, 1.5vw, 19px);
        max-width: 700px;
        line-height: 1.34;
        margin: 0;
      }

      .hero-subcopy em {
        color: var(--bg);
        font-style: italic;
        font-size: clamp(20px, 2.2vw, 24px);
      }

      .text-soft {
        color: var(--muted);
      }

      .section {
        padding: 104px 0;
      }

      .section + .section {
        border-top: 1px solid var(--hairline);
      }

      .label {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 24px;
      }

      .label strong {
        color: var(--granada);
        font-size: 12px;
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: 0.14em;
      }

      .split {
        display: grid;
        grid-template-columns: minmax(240px, 300px) 1fr;
        gap: 88px;
        align-items: start;
      }

      .section-title {
        margin: 0 0 14px;
        font-size: clamp(48px, 6.8vw, 96px);
        line-height: 0.95;
        letter-spacing: -0.03em;
      }

      .lead {
        color: var(--ink-soft);
      }

      .accent-italic {
        color: var(--granada);
        font-style: italic;
      }

      .headline-copy {
        font-size: clamp(32px, 4vw, 54px);
        font-weight: 300;
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin: 0 0 60px;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 42px;
      }

      .item-title {
        margin: 0 0 10px;
        font-size: clamp(36px, 3vw, 44px);
        letter-spacing: -0.02em;
      }

      .para-list {
        border-top: 1px solid var(--hairline);
      }

      .para-row {
        display: grid;
        grid-template-columns: 1fr 2fr 48px;
        gap: 30px;
        align-items: center;
        padding: 24px 0;
        border-bottom: 1px solid var(--hairline);
      }

      .para-row:hover {
        background: color-mix(in srgb, var(--granada) 4%, transparent);
      }

      .para-row h4 {
        margin: 0;
        font-size: clamp(28px, 3vw, 40px);
        line-height: 1;
        transition: all 0.35s;
      }

      .para-row p {
        margin: 0;
        color: var(--ink-soft);
      }

      .para-row:hover h4 {
        color: var(--granada);
        font-style: italic;
      }

      .arrow {
        color: var(--granada);
        font-size: 22px;
        text-align: right;
        opacity: 0.45;
        transform: translateX(-8px);
        transition: all 0.3s;
      }

      .para-row:hover .arrow {
        opacity: 1;
        transform: translateX(0);
      }

      .planos-wrapper {
        display: grid;
        grid-template-columns: minmax(0, 760px);
        justify-content: center;
      }

      .plan {
        padding: 56px 48px;
        border: 1px solid var(--hairline);
      }

      .plan:first-child {
        background: var(--bg);
      }

      #planos .plan--ticket {
        background: var(--bg);
        border-color: var(--hairline);
        color: var(--ink);
      }

      #planos .plan--ticket .text-soft {
        color: var(--muted);
      }

      #planos .plan--ticket .btn--accent {
        background: var(--granada);
        border-color: transparent;
        color: var(--bg);
      }

      .plan-vip {
        background: var(--granada);
        color: var(--bg);
        border-color: var(--granada);
      }

      .plan-header h3,
      .plan-meta,
      .plan-item,
      .plan-cta {
        margin-top: 16px;
      }

      .price {
        display: flex;
        align-items: flex-end;
        gap: 8px;
      }

      .price strong {
        font-size: 88px;
        font-family: 'Cormorant Garamond', Georgia, serif;
        line-height: 1;
        font-weight: 300;
        letter-spacing: -0.03em;
      }

      .plan ul {
        margin: 0;
        padding: 24px 0 0;
        list-style: none;
      }

      .plan li {
        padding: 16px 0;
        border-bottom: 1px solid color-mix(in srgb, currentColor 22%, transparent);
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .plan li:last-child {
        border-bottom: none;
      }

      .seats-left {
        margin: 22px 0 0;
        color: var(--granada);
        font-size: 12px;
        letter-spacing: 0.14em;
        line-height: 1.2;
        text-transform: uppercase;
      }

      .bio {
        display: grid;
        grid-template-columns: 2fr 3fr;
        gap: 72px;
        align-items: start;
      }

      .photo-wrap {
        position: relative;
      }

      .photo-blob {
        width: min(360px, 88vw);
        aspect-ratio: 3 / 4;
        border-radius: 50% 50% 46% 54%;
        overflow: hidden;
        position: relative;
        margin-left: -24px;
        background: linear-gradient(135deg, var(--granada) 0%, var(--granada-deep) 100%);
        transform: rotate(-8deg);
      }

      .photo-blob img {
        width: 110%;
        height: 110%;
        object-fit: cover;
        object-position: center top;
        transform: rotate(8deg) translate(-8%, -7%);
      }

      .photo-overlay {
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
          45deg,
          rgba(255, 255, 255, 0.08) 0 2px,
          transparent 2px 14px
        );
      }

      .photo-label {
        position: absolute;
        bottom: 18px;
        left: 22px;
        color: var(--bg);
        font-size: 11px;
      }

      .stats {
        margin-top: 24px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
        padding: 28px 0;
        border-top: 1px solid var(--hairline);
        border-bottom: 1px solid var(--hairline);
      }

      .stat {
        font-size: 14px;
      }

      .stat-number {
        font-size: 48px;
        line-height: 1;
        color: var(--granada);
      }

      .pill {
        border-radius: 999px;
        border: 1px solid var(--hairline);
        padding: 4px 10px;
        font-size: 11px;
        color: var(--ink-soft);
      }

      .chips {
        margin-top: 16px;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: center;
      }

      .cta-band {
        background: linear-gradient(135deg, rgba(241, 133, 35, 0.12), rgba(201, 106, 20, 0.18));
        border: 1px solid color-mix(in srgb, var(--granada) 40%, var(--bg));
      }

      .cta-inner {
        display: grid;
        gap: 34px;
      }

      .cta-inner h2 {
        margin: 0;
        max-width: 1020px;
        font-weight: 300;
        font-size: clamp(44px, 7.8vw, 112px);
        line-height: 0.95;
        letter-spacing: -0.03em;
      }

      .btn {
        display: inline-block;
        padding: 18px 26px;
        border-radius: 999px;
        border: 1px solid var(--ink);
        color: var(--ink);
        font-size: 14px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-align: center;
        text-decoration: none;
      }

      .btn:hover {
        opacity: 0.92;
      }

      .btn--accent {
        background: var(--granada);
        border-color: transparent;
        color: var(--bg);
      }

      .btn--dark {
        background: var(--ink);
        color: var(--bg);
      }

      .footer {
        border-top: 1px solid var(--hairline);
        background: var(--bg-2);
        padding: 34px 0 40px;
        color: var(--muted);
        display: flex;
        justify-content: space-between;
      }

      .sticky-cta {
        position: fixed;
        left: 16px;
        right: 16px;
        bottom: 14px;
        z-index: 110;
        display: none;
        transition:
          opacity 0.2s ease,
          transform 0.2s ease;
      }

      .sticky-cta a {
        text-align: center;
        padding: 14px 16px;
        background: var(--ink);
        color: var(--bg);
        width: 100%;
      }

      .sticky-cta--hidden {
        opacity: 0;
        pointer-events: none;
        transform: translateY(16px);
      }

      .reveal {
        animation: reveal 0.75s ease both;
      }

      .reveal-delay-1 {
        animation-delay: 0.1s;
      }

      .reveal-delay-2 {
        animation-delay: 0.2s;
      }

      .reveal-delay-3 {
        animation-delay: 0.3s;
      }

      @keyframes reveal {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 1100px) {
        :root {
          --container: min(1180px, calc(100% - 36px));
        }

        .hero {
          padding-top: 74px;
        }

        .split,
        .grid-3,
        .planos-wrapper,
        .bio,
        .hero-grid,
        .stats {
          grid-template-columns: 1fr;
        }

        .hero-grid {
          justify-content: center;
        }

        .section {
          padding: 82px 0;
        }

        .photo-wrap,
        .photo-blob {
          margin: 0 auto;
        }

        .photo-blob {
          transform: rotate(0);
          width: min(380px, 86vw);
        }

        .photo-wrap .mono {
          text-align: center;
        }
      }

      @media (max-width: 700px) {
        .hero {
          padding-top: 68px;
          padding-bottom: 28px;
        }

        .marquee-copy {
          gap: 20px;
          padding: 14px 0;
          font-size: 10px;
          letter-spacing: 0.14em;
        }

        .hero-main {
          min-height: calc(100dvh - 104px);
          gap: 14px;
        }

        .hero-title {
          font-size: clamp(46px, 15vw, 76px);
          margin: 0 0 8px;
        }

        .hero-logo-title {
          width: min(560px, 86vw);
          margin-bottom: 8px;
        }

        .countdown {
          min-height: 36px;
          margin-bottom: 14px;
          padding: 9px 14px;
          font-size: 10px;
          letter-spacing: 0.12em;
        }

        .hero-subcopy {
          font-size: 15px;
          line-height: 1.32;
        }

        .hero-copy {
          max-width: 100%;
        }

        .truth-section {
          padding: 56px 0 64px;
        }

        .truth-section .label {
          margin-bottom: 28px;
        }

        .truth-section .split {
          gap: 0;
        }

        .truth-section .truth-spacer {
          display: none;
        }

        .truth-section .split > div:last-child > .serif {
          margin-top: 0;
        }

        .para-row {
          grid-template-columns: 1fr auto;
          gap: 16px;
          align-items: start;
        }

        .para-row h4,
        .para-row p {
          grid-column: 1;
        }

        .para-row h4 {
          line-height: 1.08;
        }

        .para-row p {
          line-height: 1.45;
        }

        .para-row .arrow {
          grid-column: 2;
          grid-row: 1 / span 2;
          align-self: center;
        }

        .planos-wrapper {
          grid-template-columns: 1fr;
        }

        .plan {
          padding: 42px 28px;
        }

        .price strong {
          font-size: 76px;
        }

        .btn {
          width: 100%;
          max-width: 340px;
          padding-inline: 18px;
        }

        .sticky-cta {
          display: block;
          bottom: max(14px, env(safe-area-inset-bottom));
        }
      }
    </style>
  </head>

  <body class="grain">
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`}
        alt=""
      />
    </noscript>
    <div class="page">
      <section class="hero">
        <div class="hero-marquee" aria-hidden="true">
          <div class="marquee-track">
            <div class="marquee-copy">
              <span>Ao vivo</span>
              <span class="dot">•</span>
              <span>{marqueeDateLabel}</span>
              <span>Ao vivo</span>
              <span class="dot">•</span>
              <span>{marqueeDateLabel}</span>
              <span>Ao vivo</span>
              <span class="dot">•</span>
              <span>{marqueeDateLabel}</span>
              <span>Ao vivo</span>
              <span class="dot">•</span>
              <span>{marqueeDateLabel}</span>
            </div>
            <div class="marquee-copy">
              <span>Ao vivo</span>
              <span class="dot">•</span>
              <span>{marqueeDateLabel}</span>
              <span>Ao vivo</span>
              <span class="dot">•</span>
              <span>{marqueeDateLabel}</span>
              <span>Ao vivo</span>
              <span class="dot">•</span>
              <span>{marqueeDateLabel}</span>
              <span>Ao vivo</span>
              <span class="dot">•</span>
              <span>{marqueeDateLabel}</span>
            </div>
          </div>
        </div>
        <div class="shell hero-shell">
          <div class="hero-main">
            <div class="hero-grid reveal reveal-delay-1">
              <div class="hero-copy">
                <h1 class="hero-logo-title">
                  <span class="sr-only">Marca Inevitável</span>
                  <img class="hero-logo" src={logoImage} alt="" />
                </h1>
                <div
                  class="countdown"
                  data-countdown
                  data-countdown-target={eventCountdownTarget}
                  aria-live="polite"
                >
                  faltam --d --h --m --s
                </div>
                <p class="hero-subcopy">
                  <strong>Sua marca está à altura da sua entrega?</strong><br />
                  Se você entrega excelência, mas ainda não é percebido como deveria,
                  existe um desalinhamento estratégico.
                  <br /><br />Nos dias {eventDateLabel}, Yasmin Corbo conduz ao vivo a
                  <strong>Imersão Marca Inevitável</strong>.
                  <br />Dois dias para ajustar o que sustenta (ou limita) o crescimento da sua marca.
                </p>
                <div style="margin-top: 22px">
                  <a class="btn btn--accent" href="#planos">QUERO GARANTIR MINHA VAGA</a>
                </div>
              </div>
            </div>
          </div>
        </div>

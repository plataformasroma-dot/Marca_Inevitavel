---
import { pageAssets, withBasePath } from '../lib/asset-paths.js';

const whatsappGroupUrl =
  import.meta.env.PUBLIC_WHATSAPP_GROUP_URL ??
  'https://chat.whatsapp.com/KzAgEuIxzHW8WE1NTEFsWc?mode=gi_t';
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID ?? '1269431951336148';

const assetPath = (path) => withBasePath(import.meta.env.BASE_URL, path);
const assetStyleVars = [
  `--font-editorial-regular-src: url("${assetPath(pageAssets.fontEditorialRegular)}") format("woff")`,
  `--font-editorial-italic-src: url("${assetPath(pageAssets.fontEditorialItalic)}") format("woff")`,
  `--font-aileron-bold-src: url("${assetPath(pageAssets.fontAileronBold)}") format("woff")`,
  `--hero-image: url("${assetPath(pageAssets.hero)}")`
].join('; ');
---

<!doctype html>
<html lang="pt-BR" style={assetStyleVars}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Obrigado pela sua compra. Entre no grupo do WhatsApp para finalizar sua inscri&ccedil;&atilde;o na Imers&atilde;o Marca Inevit&aacute;vel."
    />
    <title>Obrigado | Marca Inevit&aacute;vel</title>
    <script is:inline define:vars={{ metaPixelId }}>
      !function(f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function() {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = true;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = true;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', metaPixelId);
      fbq('track', 'PageView');
      fbq('track', 'CompleteRegistration');
    </script>
    <style>
      @font-face {
        font-family: 'PP Editorial New';
        src: var(--font-editorial-regular-src);
        font-style: normal;
        font-weight: 200;
        font-display: swap;
      }

      @font-face {
        font-family: 'PP Editorial New';
        src: var(--font-editorial-italic-src);
        font-style: italic;
        font-weight: 200;
        font-display: swap;
      }

      @font-face {
        font-family: 'Aileron Extra Bold';
        src: var(--font-aileron-bold-src);
        font-style: normal;
        font-weight: 800;
        font-display: swap;
      }

      :root {
        --bg: #f5f0e8;
        --ink: #060b28;
        --ink-deep: #02061e;
        --granada: #f18523;
        --granada-hover: #ff962f;
        --container: min(1060px, calc(100% - 48px));
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: var(--ink);
        color: var(--bg);
        font-family: 'Aileron Extra Bold', Arial, sans-serif;
        font-size: 16px;
        line-height: 1.45;
        font-synthesis: none;
      }

      body {
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .grain::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.28;
        mix-blend-mode: multiply;
        z-index: 50;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.12  0 0 0 0 0.08  0 0 0 0 0.06  0 0 0 0.1 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
      }

      .thank-you {
        position: relative;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 92px 0 48px;
        overflow: hidden;
        text-align: center;
        background: var(--hero-image) center/cover no-repeat;
      }

      .thank-you::before,
      .thank-you::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .thank-you::before {
        z-index: 0;
        background:
          linear-gradient(90deg, rgba(2, 6, 30, 0.18), rgba(2, 6, 30, 0.74) 36%, rgba(2, 6, 30, 0.68) 64%, rgba(2, 6, 30, 0.2)),
          linear-gradient(180deg, rgba(2, 6, 30, 0.08), rgba(2, 6, 30, 0.48) 70%, rgba(2, 6, 30, 0.74));
      }

      .thank-you::after {
        z-index: 1;
        opacity: 0.72;
        background:
          radial-gradient(ellipse at 7% 22%, rgba(241, 133, 35, 0.2), transparent 30%),
          radial-gradient(ellipse at 88% 22%, rgba(43, 126, 190, 0.24), transparent 34%),
          radial-gradient(ellipse at 82% 82%, rgba(18, 86, 145, 0.14), transparent 36%);
        mix-blend-mode: screen;
      }

      .marquee {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 80;
        overflow: hidden;
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(4, 8, 34, 0.72);
        backdrop-filter: blur(8px);
        pointer-events: none;
      }

      .marquee-track {
        display: inline-flex;
        width: max-content;
        min-width: 200%;
        flex-wrap: nowrap;
        animation: marquee 26s linear infinite;
      }

      .marquee-copy {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        gap: 24px;
        padding: 16px 12px;
        white-space: nowrap;
        color: var(--granada);
        font-size: 11px;
        letter-spacing: 0.18em;
        line-height: 1;
        text-transform: uppercase;
      }

      .marquee-copy .dot {
        opacity: 0.45;
      }

      @keyframes marquee {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-50%);
        }
      }

      .shell {
        position: relative;
        z-index: 3;
        width: var(--container);
        margin: 0 auto;
      }

      .content {
        display: grid;
        justify-items: center;
      }

      .title {
        position: relative;
        margin: 0 0 10px;
        color: var(--bg);
        font-family: 'PP Editorial New', Georgia, serif;
        font-size: clamp(104px, 16vw, 220px);
        font-style: italic;
        font-weight: 200;
        letter-spacing: 0;
        line-height: 0.78;
        text-shadow: 0 20px 52px rgba(0, 0, 0, 0.44);
      }

      .title::after {
        content: '';
        display: block;
        width: min(460px, 62%);
        height: 1px;
        margin: 26px auto 0;
        background: linear-gradient(90deg, transparent, rgba(241, 133, 35, 0.95), transparent);
      }

      .copy {
        max-width: 740px;
        margin: 22px auto 0;
        color: #fff;
        font-size: clamp(18px, 1.8vw, 23px);
        line-height: 1.3;
      }

      .copy strong {
        color: var(--bg);
      }

      .cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 60px;
        margin-top: 32px;
        padding: 18px 38px;
        border-radius: 999px;
        background: var(--granada);
        color: var(--bg);
        font-size: 14px;
        letter-spacing: 0.08em;
        text-align: center;
        text-transform: uppercase;
        box-shadow:
          0 18px 40px rgba(0, 0, 0, 0.28),
          0 0 0 1px rgba(245, 240, 232, 0.08) inset;
        transition:
          background 0.2s ease,
          box-shadow 0.2s ease,
          transform 0.2s ease;
      }

      .cta:hover {
        background: var(--granada-hover);
        box-shadow:
          0 22px 46px rgba(0, 0, 0, 0.34),
          0 0 0 1px rgba(245, 240, 232, 0.12) inset;
        transform: translateY(-1px);
      }

      .note {
        margin: 20px auto 0;
        max-width: 650px;
        color: rgba(245, 240, 232, 0.82);
        font-size: 14px;
        line-height: 1.45;
      }

      .proof {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-top: 28px;
        color: rgba(245, 240, 232, 0.86);
        font-size: 12px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .proof::before,
      .proof::after {
        content: '';
        width: 42px;
        height: 1px;
        background: rgba(245, 240, 232, 0.34);
      }

      .reveal {
        animation: reveal 0.75s ease both;
      }

      .reveal-delay-1 {
        animation-delay: 0.12s;
      }

      .reveal-delay-2 {
        animation-delay: 0.22s;
      }

      @keyframes reveal {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 700px) {
        :root {
          --container: min(100% - 32px, 920px);
        }

        .thank-you {
          place-items: start center;
          padding-top: 168px;
          padding-bottom: 32px;
          background-position: 16% center;
          background-size: auto 100%;
        }

        .thank-you::before {
          background:
            radial-gradient(ellipse at 50% 40%, rgba(2, 6, 30, 0.58), rgba(2, 6, 30, 0.3) 42%, rgba(2, 6, 30, 0.18) 68%, rgba(2, 6, 30, 0.42)),
            linear-gradient(180deg, rgba(2, 6, 30, 0.08), rgba(2, 6, 30, 0.38) 62%, rgba(2, 6, 30, 0.74));
        }

        .thank-you::after {
          opacity: 0.86;
          background:
            radial-gradient(ellipse at -12% 16%, rgba(241, 133, 35, 0.5), transparent 42%),
            radial-gradient(ellipse at 108% 20%, rgba(51, 135, 202, 0.48), transparent 46%),
            radial-gradient(ellipse at 82% 86%, rgba(12, 93, 160, 0.24), transparent 46%);
        }

        .marquee-copy {
          gap: 18px;
          padding: 14px 0;
          font-size: 10px;
          letter-spacing: 0.14em;
        }

        .title {
          font-size: clamp(78px, 23vw, 92px);
          line-height: 0.8;
        }

        .title::after {
          width: min(320px, 70%);
          margin-top: 18px;
        }

        .copy {
          margin-top: 20px;
          font-size: 16px;
        }

        .cta {
          width: 100%;
          max-width: 350px;
          min-height: 56px;
          padding-inline: 18px;
        }

        .note {
          font-size: 13px;
        }

        .proof {
          margin-top: 22px;
          font-size: 10px;
          letter-spacing: 0.12em;
        }

        .proof::before,
        .proof::after {
          width: 24px;
        }
      }
    </style>
  </head>

  <body class="grain">
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`}
        alt=""
      />
    </noscript>
    <main class="thank-you">
      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          <div class="marquee-copy">
            <span>Compra recebida</span>
            <span class="dot">&bull;</span>
            <span>Pr&oacute;ximo passo: WhatsApp</span>
            <span>Compra recebida</span>
            <span class="dot">&bull;</span>
            <span>Pr&oacute;ximo passo: WhatsApp</span>
          </div>
          <div class="marquee-copy">
            <span>Compra recebida</span>
            <span class="dot">&bull;</span>
            <span>Pr&oacute;ximo passo: WhatsApp</span>
            <span>Compra recebida</span>
            <span class="dot">&bull;</span>
            <span>Pr&oacute;ximo passo: WhatsApp</span>
          </div>
        </div>
      </div>

      <section class="shell content" aria-labelledby="thank-you-title">
        <h1 id="thank-you-title" class="title reveal">obrigado!</h1>
        <p class="copy reveal reveal-delay-1">
          Sua compra foi recebida. Agora falta o &uacute;ltimo passo:
          entre no grupo do WhatsApp para garantir sua vaga e receber os acessos da imers&atilde;o.
        </p>
        <a class="cta reveal reveal-delay-2" href={whatsappGroupUrl} target="_blank" rel="noreferrer">
          Entrar no grupo do WhatsApp
        </a>
        <p class="note reveal reveal-delay-2">
          O grupo &eacute; silencioso e ser&aacute; usado apenas para avisos importantes, links e pr&oacute;ximos passos.
        </p>
        <p class="proof reveal reveal-delay-2">Vaga quase confirmada</p>
      </section>
    </main>
  </body>
</html>

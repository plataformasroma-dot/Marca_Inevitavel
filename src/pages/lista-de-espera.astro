---
import { pageAssets, withBasePath } from '../lib/asset-paths.js';

const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID ?? '1269431951336148';
const assetPath = (path) => withBasePath(import.meta.env.BASE_URL, path);
const assetStyleVars = [
  `--font-editorial-regular-src: url("${assetPath(pageAssets.fontEditorialOldRegular)}") format("opentype")`,
  `--font-editorial-italic-src: url("${assetPath(pageAssets.fontEditorialOldItalic)}") format("opentype")`,
  `--font-aileron-regular-src: url("${assetPath(pageAssets.fontAileronRegular)}") format("opentype")`,
  `--font-aileron-bold-src: url("${assetPath(pageAssets.fontAileronBoldOtf)}") format("opentype")`,
  `--hero-image: url("${assetPath(pageAssets.hero)}")`
].join('; ');
const logoImage = assetPath(pageAssets.logo);
---

<!doctype html>
<html lang="pt-BR" style={assetStyleVars}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Inscreva-se para a Imersão Marca Inevitável, nos dias 25 e 26 de julho."
    />
    <title>Inscrição | Imersão Marca Inevitável</title>
    <script is:inline define:vars={{ metaPixelId }}>
      !function(f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function() {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = true;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = true;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', metaPixelId);
      fbq('track', 'PageView');
    </script>
    <style>
      @font-face {
        font-family: 'PP Editorial Old';
        src: var(--font-editorial-regular-src);
        font-style: normal;
        font-weight: 200;
        font-display: swap;
      }

      @font-face {
        font-family: 'PP Editorial Old';
        src: var(--font-editorial-italic-src);
        font-style: italic;
        font-weight: 200;
        font-display: swap;
      }

      @font-face {
        font-family: 'Aileron';
        src: var(--font-aileron-regular-src);
        font-style: normal;
        font-weight: 400;
        font-display: swap;
      }

      @font-face {
        font-family: 'Aileron';
        src: var(--font-aileron-bold-src);
        font-style: normal;
        font-weight: 700;
        font-display: swap;
      }

      :root {
        --ink: #060b28;
        --ink-deep: #03061a;
        --paper: #f5f0e8;
        --accent: #f18523;
        --accent-soft: #ffae64;
        --shell: min(1240px, calc(100% - 64px));
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        min-height: 100%;
        margin: 0;
      }

      body {
        background: var(--ink-deep);
        color: var(--paper);
        font-family: 'Aileron', Arial, sans-serif;
        font-weight: 400;
        font-synthesis: none;
      }

      .page {
        position: relative;
        isolation: isolate;
        min-height: 100dvh;
        overflow: hidden;
        background: var(--ink-deep) var(--hero-image) center / cover no-repeat;
      }

      .page::before,
      .page::after {
        position: absolute;
        inset: 0;
        z-index: -1;
        content: '';
        pointer-events: none;
      }

      .page::before {
        background:
          linear-gradient(90deg, rgba(3, 6, 26, 0.9) 0%, rgba(3, 6, 26, 0.72) 48%, rgba(3, 6, 26, 0.54) 100%),
          linear-gradient(180deg, rgba(3, 6, 26, 0.08) 0%, rgba(3, 6, 26, 0.7) 100%);
      }

      .page::after {
        opacity: 0.75;
        background:
          radial-gradient(ellipse at 7% 15%, rgba(241, 133, 35, 0.22), transparent 32%),
          radial-gradient(ellipse at 94% 92%, rgba(26, 108, 183, 0.2), transparent 34%);
      }

      .shell {
        width: var(--shell);
        min-height: 100dvh;
        margin: 0 auto;
        padding: 34px 0;
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(420px, 510px);
        align-items: center;
        gap: clamp(48px, 6vw, 104px);
      }

      .intro {
        max-width: 590px;
      }

      .brand {
        display: block;
        width: min(290px, 72vw);
        height: auto;
        margin-bottom: clamp(42px, 7vh, 80px);
      }

      .eyebrow {
        margin: 0 0 18px;
        color: var(--accent-soft);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.16em;
        line-height: 1.2;
        text-transform: uppercase;
      }

      h1 {
        max-width: 640px;
        margin: 0;
        font-family: 'PP Editorial Old', Georgia, serif;
        font-size: clamp(54px, 4.7vw, 64px);
        font-weight: 200;
        letter-spacing: -0.045em;
        line-height: 0.92;
      }

      @media (min-width: 921px) {
        h1 span {
          display: block;
        }
      }

      .intro-copy {
        max-width: 500px;
        margin: 30px 0 0;
        color: rgba(245, 240, 232, 0.9);
        font-family: 'PP Editorial Old', Georgia, serif;
        font-size: clamp(21px, 2vw, 27px);
        font-weight: 200;
        line-height: 1.25;
      }

      .event-copy {
        max-width: 500px;
        margin: 20px 0 0;
        color: rgba(245, 240, 232, 0.76);
        font-size: 15px;
        line-height: 1.45;
      }

      .event-copy strong {
        color: var(--paper);
        font-weight: 700;
      }

      .form-area {
        width: 100%;
      }

      .form-card {
        position: relative;
        width: 100%;
        padding: 0;
        border: 1px solid rgba(245, 240, 232, 0.46);
        border-radius: 16px;
        background: rgba(3, 6, 26, 0.12);
        box-shadow: 0 24px 70px rgba(1, 4, 20, 0.28);
      }

      .form-card::before {
        position: absolute;
        inset: 1px;
        border: 1px solid rgba(245, 240, 232, 0.12);
        border-radius: inherit;
        content: '';
        pointer-events: none;
      }

      .form-frame {
        height: 360px;
        overflow: hidden;
        border-radius: 15px;
        background: transparent;
      }

      .form-frame iframe {
        display: block;
      }

      @media (max-width: 920px) {
        :root {
          --shell: min(680px, calc(100% - 40px));
        }

        .shell {
          grid-template-columns: 1fr;
          align-items: start;
          gap: 42px;
          padding: 30px 0 40px;
        }

        .brand {
          width: min(250px, 72vw);
          margin-bottom: 42px;
        }

        h1 {
          max-width: 520px;
          font-size: clamp(54px, 11vw, 82px);
        }

        .intro-copy {
          max-width: 520px;
          margin-top: 22px;
        }
      }

      @media (max-width: 540px) {
        :root {
          --shell: min(100% - 28px, 680px);
        }

        .page {
          background-position: 45% center;
        }

        .shell {
          gap: 34px;
          padding: 24px 0 28px;
        }

        .brand {
          width: min(220px, 76vw);
          margin-bottom: 36px;
        }

        .eyebrow {
          margin-bottom: 14px;
          font-size: 10px;
        }

        h1 {
          font-size: clamp(48px, 15vw, 68px);
          line-height: 0.94;
        }

        .intro-copy {
          margin-top: 20px;
          font-size: 21px;
        }

        .form-card {
          border-radius: 12px;
        }

        .form-frame {
          border-radius: 11px;
        }
      }
    </style>
  </head>

  <body>
    <main class="page">
      <div class="shell">
        <section class="intro" aria-labelledby="event-title">
          <img class="brand" src={logoImage} alt="Imersão Marca Inevitável" />
          <p class="eyebrow">25 e 26 de julho</p>
          <h1 id="event-title"><span>Sua marca está à altura</span> <span>da sua entrega?</span></h1>
          <p class="intro-copy">
            Se você entrega excelência, mas ainda não é percebido como deveria, existe um desalinhamento estratégico.
          </p>
          <p class="event-copy">
            Nos dias 25 e 26 de julho, Yasmin Corbo conduz ao vivo a <strong>Imersão Marca Inevitável</strong>.
            Dois dias para ajustar o que sustenta (ou limita) o crescimento da sua marca.
          </p>
        </section>

        <section class="form-area" aria-label="Formulário de inscrição na Imersão Marca Inevitável">
          <div class="form-card">
            <div class="form-frame">
              <iframe
                src="https://api.leadconnectorhq.com/widget/form/t5CbzK7maOThITJVWiRj"
                style="width:100%;height:100%;border:none;border-radius:0px"
                id="inline-t5CbzK7maOThITJVWiRj"
                data-layout="{'id':'INLINE'}"
                data-trigger-type="alwaysShow"
                data-trigger-value=""
                data-activation-type="alwaysActivated"
                data-activation-value=""
                data-deactivation-type="neverDeactivate"
                data-deactivation-value=""
                data-form-name="imersão Marca Inevitavel - pagina nova"
                data-height="360"
                data-layout-iframe-id="inline-t5CbzK7maOThITJVWiRj"
                data-form-id="t5CbzK7maOThITJVWiRj"
                title="imersão Marca Inevitavel - pagina nova"
              >
              </iframe>
            </div>
          </div>
        </section>
      </div>
    </main>

    <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
  </body>
</html>
